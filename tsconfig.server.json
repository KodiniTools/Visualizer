{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.js",
    "electron/localServer.mjs",
    "electron/updater.mjs",
    "electron/__tests__/*.js",
    "desktop/stage.mjs",
    "ecosystem.config.cjs"
  ]
}
